{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/commercial-connection-audit-v1.json",
  "title": "Commercial connection audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditedBase", "approvedMigrationTip", "connectionPoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "auditedBase": { "$ref": "#/$defs/commit" },
    "approvedMigrationTip": { "$ref": "#/$defs/commit" },
    "connectionPoints": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/connectionPoint" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "historySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "path": { "$ref": "#/$defs/nonempty" }
      }
    },
    "connectionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "connectionType",
        "historySources",
        "disposition",
        "replacementPaths",
        "replacementRegressionCheck",
        "evidenceStatus"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^CP-(0[1-9]|1[0-7])$" },
        "connectionType": { "$ref": "#/$defs/nonempty" },
        "historySources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/historySource" } },
        "disposition": { "enum": ["remove", "replace"] },
        "replacementPaths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" } },
        "replacementRegressionCheck": { "$ref": "#/$defs/nonempty" },
        "evidenceStatus": { "const": "verified" }
      }
    }
  }
}
