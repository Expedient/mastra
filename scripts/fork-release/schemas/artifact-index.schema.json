{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.expedient.invalid/fork-release/artifact-index-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifact", "reviewedBaselineCommit", "releaseCommit", "toolchain", "packages"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^@expedient/[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1, "pattern": "^\\S+$" }
      }
    },
    "reviewedBaselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm"],
      "properties": {
        "node": { "const": "22.23.1" },
        "pnpm": { "const": "11.13.1" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "file", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^(?:mastra|@mastra/[a-z0-9][a-z0-9-]*)$" },
          "version": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9@._+-]+\\.tgz$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
