{
  "name": "@internal/auth",
  "version": "0.0.11",
  "description": "Internal Mastra auth primitives and utilities",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./provider": {
      "import": {
        "types": "./dist/provider/index.d.ts",
        "default": "./dist/provider/index.js"
      },
      "require": {
        "types": "./dist/provider/index.d.ts",
        "default": "./dist/provider/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./session": {
      "import": {
        "types": "./dist/session/index.d.ts",
        "default": "./dist/session/index.js"
      },
      "require": {
        "types": "./dist/session/index.d.ts",
        "default": "./dist/session/index.cjs"
      }
    },
    "./authorization": {
      "import": {
        "types": "./dist/authorization.d.ts",
        "default": "./dist/authorization.js"
      },
      "require": {
        "types": "./dist/authorization.d.ts",
        "default": "./dist/authorization.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "tsdown --watch --silent --config tsdown.config.ts",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@internal/core": "workspace:*"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "^10.7.0",
    "tsdown": "0.22.9",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.9.4"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/_internals/auth"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
